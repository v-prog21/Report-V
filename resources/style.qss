/* =====================================================================
   Support IL — светлая тема
   ===================================================================== */

* {
    font-family: "Segoe UI Variable Text", "Segoe UI", "Inter", sans-serif;
    outline: none;
}

QWidget {
    color: #0f172a;
    font-size: 10pt;
}

QMainWindow,
QDialog {
    background-color: #f3f5fa;
}

QWidget#centralShell {
    background-color: #f3f5fa;
}

QWidget#page {
    background: transparent;
}

/* ------------------------------- Шапка ------------------------------ */
QFrame#appHeader {
    background-color: #ffffff;
    border: none;
    border-bottom: 1px solid #e3e8f2;
}

QLabel#appTitle {
    font-size: 16pt;
    font-weight: 700;
    color: #0f172a;
}

QLabel#appSubtitle {
    font-size: 9pt;
    color: #7b879c;
}

QLabel#sectionTitle {
    font-size: 13pt;
    font-weight: 700;
    color: #0f172a;
}

QLabel#emptyTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #334155;
}

QLabel#emptyText {
    font-size: 10pt;
    color: #7b879c;
}

QLabel#muted {
    color: #64748b;
    font-size: 9pt;
}

QLabel#chip {
    background-color: #f1f5f9;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-radius: 11px;
    padding: 5px 12px;
    font-size: 9pt;
    font-weight: 600;
}

QLabel#adminChip {
    background-color: #e8f7ef;
    color: #047857;
    border: 1px solid #c9efd9;
    border-radius: 11px;
    padding: 5px 12px;
    font-size: 9pt;
    font-weight: 700;
}

/* ------------------------------ Вкладки ----------------------------- */
QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabWidget#mainTabs::pane {
    border: none;
    background: transparent;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    color: #64748b;
    padding: 9px 20px;
    margin: 8px 4px 7px 0;
    border: 1px solid transparent;
    border-radius: 9px;
    font-weight: 600;
    font-size: 10pt;
}

QTabBar::tab:hover:!selected {
    background: #e9eef8;
    color: #334155;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #1d4ed8;
    border: 1px solid #dbe4f3;
}

/* ------------------------------ Карточки ---------------------------- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e3e8f2;
    border-radius: 12px;
    margin-top: 17px;
    padding: 20px 14px 14px 14px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    top: 2px;
    padding: 0 6px;
    background-color: #ffffff;
    color: #1e293b;
    font-weight: 700;
    font-size: 10pt;
}

QFrame#ticketHeader {
    background-color: #f8fafc;
    border: 1px solid #e8edf5;
    border-radius: 10px;
}

/* ------------------------------- Кнопки ----------------------------- */
QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #2563eb;
    border-radius: 8px;
    padding: 7px 16px;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #1d4ed8;
}

QPushButton:pressed {
    background-color: #1e40af;
    border-color: #1e40af;
}

QPushButton:disabled {
    background-color: #c7d2e4;
    border-color: #c7d2e4;
    color: #f8fafc;
}

QPushButton#btnSecondary {
    background-color: #ffffff;
    color: #334155;
    border: 1px solid #d7dfec;
}

QPushButton#btnSecondary:hover {
    background-color: #f4f7fd;
    border-color: #b9c7dd;
}

QPushButton#btnGhost {
    background-color: transparent;
    color: #2563eb;
    border: 1px solid transparent;
    padding: 4px 8px;
}

QPushButton#btnGhost:hover {
    background-color: #eaf1ff;
}

QPushButton#btnDanger {
    background-color: #dc2626;
    border-color: #dc2626;
}

QPushButton#btnDanger:hover {
    background-color: #b91c1c;
    border-color: #b91c1c;
}

QPushButton#btnSuccess {
    background-color: #059669;
    border-color: #059669;
    color: #ffffff;
}

QPushButton#btnSuccess:hover {
    background-color: #047857;
    border-color: #047857;
}

QPushButton#btnSend {
    padding-left: 24px;
    padding-right: 24px;
}

/* ------------------------------ Поля ввода -------------------------- */
QLineEdit,
QTextEdit,
QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 9px;
    padding: 7px 11px;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border: 1px solid #2563eb;
}

QLineEdit:disabled,
QTextEdit:disabled {
    background-color: #f4f6fa;
    color: #94a3b8;
}

QLineEdit[readOnly="true"] {
    background-color: #f8fafc;
    color: #64748b;
}

/* ------------------------------ Таблицы ----------------------------- */
QTableView,
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #fbfcff;
    border: 1px solid #e3e8f2;
    border-radius: 10px;
    gridline-color: transparent;
    outline: 0;
    selection-background-color: #e8f0ff;
    selection-color: #1e3a8a;
}

QTableView::item,
QTableWidget::item {
    padding: 6px 8px;
    border: none;
}

QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #f6f9ff;
}

QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #e8f0ff;
    color: #1e3a8a;
}

QHeaderView::section {
    background-color: #f7f9fd;
    color: #64748b;
    padding: 9px 10px;
    border: none;
    border-bottom: 1px solid #e3e8f2;
    font-size: 9pt;
    font-weight: 700;
}

QHeaderView::section:hover {
    background-color: #eef3fb;
    color: #2563eb;
}

QTableCornerButton::section {
    background-color: #f7f9fd;
    border: none;
}

/* ----------------------------- Скроллбары --------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #94a3b8;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background: #cbd5e1;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background: #94a3b8;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
    border: none;
    background: transparent;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: transparent;
}

/* ------------------------------- Чат -------------------------------- */
QScrollArea#chatScroll {
    background-color: #f8fafc;
    border: 1px solid #e8edf5;
    border-radius: 10px;
}

QScrollArea#chatScroll QWidget#qt_scrollarea_viewport {
    background-color: #f8fafc;
}

QWidget#chatCanvas {
    background-color: #f8fafc;
}

QFrame#bubbleOwn {
    background-color: #dbeafe;
    border: 1px solid #bfdbfe;
    border-radius: 10px;
}

QFrame#bubbleOther {
    background-color: #ffffff;
    border: 1px solid #e3e8f2;
    border-radius: 10px;
}

QLabel#detailTitle {
    font-size: 11pt;
    color: #0f172a;
    padding: 2px 2px 4px 2px;
}

QWidget#headerBar {
    background-color: #ffffff;
    border-bottom: 1px solid #e3e8f2;
}

QLabel#headerTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #0f172a;
}

QLabel#headerMeta {
    color: #64748b;
    font-size: 9pt;
    padding: 0 6px;
}

QFrame#hline {
    background-color: #eef2f8;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* ------------------------------ Списки ------------------------------ */
QListWidget#linkList {
    background-color: #ffffff;
    alternate-background-color: #fbfcff;
    border: 1px solid #e3e8f2;
    border-radius: 10px;
    padding: 4px;
}

QListWidget#linkList::item {
    padding: 11px 10px;
    border-radius: 7px;
    margin: 1px 2px;
}

QListWidget#linkList::item:hover {
    background-color: #f6f9ff;
}

QListWidget#linkList::item:selected {
    background-color: #e8f0ff;
    color: #1e3a8a;
}

/* --------------------------- QSplitter ------------------------------ */
QSplitter::handle {
    background: transparent;
}

QSplitter::handle:horizontal {
    width: 8px;
}

/* --------------------------- QComboBox ------------------------------ */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 9px;
    padding: 6px 12px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #b9c7dd;
}

QComboBox:focus {
    border-color: #2563eb;
}

QComboBox::drop-down {
    border: none;
    width: 26px;
}

QComboBox::down-arrow {
    image: url(:/icons/chevron.svg);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: 4px;
    selection-background-color: #eaf1ff;
    selection-color: #1d4ed8;
    outline: 0;
}

/* --------------------------- QCheckBox ------------------------------ */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #cbd5e1;
    border-radius: 5px;
    background-color: #ffffff;
}

QCheckBox::indicator:hover {
    border-color: #93b4f5;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #2563eb;
    image: url(:/icons/check.svg);
}

/* --------------------------- QProgressBar --------------------------- */
QProgressBar {
    background-color: #e9eef7;
    border: none;
    border-radius: 4px;
    max-height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 4px;
}

/* ------------------------------ Меню -------------------------------- */
QMenu {
    background-color: #ffffff;
    border: 1px solid #dbe3ef;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 7px 26px 7px 12px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: #eaf1ff;
    color: #1d4ed8;
}

QMenu::item:disabled {
    color: #94a3b8;
}

QMenu::separator {
    height: 1px;
    background-color: #eef2f8;
    margin: 4px 6px;
}

/* --------------------------- Подсказки ------------------------------ */
QToolTip {
    background-color: #0f172a;
    color: #f8fafc;
    border: none;
    border-radius: 7px;
    padding: 6px 9px;
    font-size: 9pt;
}

/* --------------------------- QStatusBar ----------------------------- */
QStatusBar {
    background-color: #ffffff;
    border-top: 1px solid #e3e8f2;
    color: #64748b;
    font-size: 9pt;
    padding: 3px 10px;
}

QStatusBar::item {
    border: none;
}

/* ----------------------------- Диалоги ------------------------------ */
QDialogButtonBox QPushButton {
    min-width: 90px;
}

QFormLayout QLabel {
    color: #334155;
}
